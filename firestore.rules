rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for User
    function isValidUser(data) {
      return (
               (data.keys().hasAll(['email', 'role', 'createdAt', 'firstName', 'lastName']) && data.keys().size() == 5) ||
               (data.keys().hasAll(['email', 'role', 'createdAt']) && data.keys().size() == 3)
             ) &&
             data.email is string && data.email.size() <= 200 &&
             (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 200)) &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 200)) &&
             data.role is string && (data.role == 'user' || data.role == 'admin') &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       (incoming().role == 'user' || (incoming().role == 'admin' && request.auth.token.email == 'rsef.org@gmail.com')) && // Cannot self-assign admin unless they are the admin email
                       incoming().createdAt == request.time;
      allow update: if (
        isAdmin() ||
        (
          isOwner(userId) && isValidId(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
          incoming().email is string && incoming().email.size() <= 200
        )
      );
      allow delete: if isAdmin();
    }

    // Validation for Admins
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Needed for checking if someone is admin
      allow write: if isSignedIn() && request.auth.uid == adminId && request.auth.token.email == 'rsef.org@gmail.com';
    }

    // Validation for Submission
    function isValidSubmissionNew(data) {
      return data.keys().hasAll(['userId', 'email', 'fullName', 'abstract', 'personalStatement', 'status', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.abstract is string && data.abstract.size() <= 20000 && // rough limit
             data.personalStatement is string && data.personalStatement.size() <= 20000 &&
             data.status == 'pending' &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('age' in data) || data.age is string) &&
             (!('country' in data) || data.country is string) &&
             (!('city' in data) || data.city is string) &&
             (!('schoolName' in data) || data.schoolName is string) &&
             (!('projectTitle' in data) || data.projectTitle is string) &&
             (!('category' in data) || data.category is string) &&
             (!('participationType' in data) || data.participationType is string) &&
             (!('teamMembers' in data) || data.teamMembers is string) &&
             (!('fileUrl' in data) || data.fileUrl is string) &&
             (!('fileName' in data) || data.fileName is string) &&
             (!('heardAbout' in data) || data.heardAbout is string) &&
             (!('otherHeardAbout' in data) || data.otherHeardAbout is string) &&
             (!('competedBefore' in data) || data.competedBefore is string) &&
             (!('travelSupport' in data) || data.travelSupport is string) &&
             (!('blitz1' in data) || data.blitz1 is string) &&
             (!('blitz2' in data) || data.blitz2 is string) &&
             (!('blitz3' in data) || data.blitz3 is string);
    }

    function isValidSubmissionUpdate(data) {
      return data.userId is string &&
             data.email is string && data.email.size() <= 200 &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.abstract is string && data.abstract.size() <= 20000 &&
             data.personalStatement is string && data.personalStatement.size() <= 20000 &&
             data.status is string && (data.status == 'pending' || data.status == 'selected' || data.status == 'rejected' || data.status == 'declined') &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('age' in data) || data.age is string) &&
             (!('country' in data) || data.country is string) &&
             (!('city' in data) || data.city is string) &&
             (!('schoolName' in data) || data.schoolName is string) &&
             (!('projectTitle' in data) || data.projectTitle is string) &&
             (!('category' in data) || data.category is string) &&
             (!('participationType' in data) || data.participationType is string) &&
             (!('teamMembers' in data) || data.teamMembers is string) &&
             (!('fileUrl' in data) || data.fileUrl is string) &&
             (!('fileName' in data) || data.fileName is string) &&
             (!('heardAbout' in data) || data.heardAbout is string) &&
             (!('otherHeardAbout' in data) || data.otherHeardAbout is string) &&
             (!('competedBefore' in data) || data.competedBefore is string) &&
             (!('travelSupport' in data) || data.travelSupport is string) &&
             (!('blitz1' in data) || data.blitz1 is string) &&
             (!('blitz2' in data) || data.blitz2 is string) &&
             (!('blitz3' in data) || data.blitz3 is string);
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (resource == null || isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || (existing().userId == request.auth.uid));
      
      allow create: if isSignedIn() && isValidId(submissionId) &&
                       isValidSubmissionNew(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
                       
      allow update: if isSignedIn() && isValidId(submissionId) && isValidSubmissionUpdate(incoming()) && (
        (
          isAdmin() && // Admins can update status
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().updatedAt == request.time &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt
        )
      );
      
      allow delete: if isAdmin() && isValidId(submissionId);
    }
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
